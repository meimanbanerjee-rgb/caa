# InsightForge AI - Environment Configuration Template
# Copy this file to .env and configure your preferences.
# The app is fully operational deterministically even if LLM_API_KEY is left blank!

# ---------- AI PROVIDER (optional) ----------
# Options: gemini | openai | anthropic | none
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# ---------- APP SETTINGS ----------
MAX_UPLOAD_MB=25
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./insightforge.db
UPLOAD_RETENTION_DAYS=7
HOST=127.0.0.1
PORT=8000
